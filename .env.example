# Festivus root environment variables.
#
# Copy this file to `.env.local` and fill in any values you need to
# override. Most local-dev work needs nothing here; the per-package
# .env.example files (api/.env.example, apps/web/.env.example) cover
# the common cases. `.env.local` is gitignored.

# Postgres connection string. The default below points at the local
# Supabase stack (`supabase start` brings it up). Override only if you
# want to point at a different database.
POSTGRES_URL=postgresql://postgres:postgres@localhost:54322/postgres
