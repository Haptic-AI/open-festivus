# apps/web: Next.js environment variables.
#
# Copy this file to `apps/web/.env.local` and fill in values for local
# dev. `apps/web/.env.local` is gitignored.

# --- Auth (Clerk) -----------------------------------------------------------

# Clerk server-side secret. Required in any deployed environment.
# Generate at https://dashboard.clerk.com.
CLERK_SECRET_KEY=

# Clerk client-side publishable key. Exposed to the browser by design
# (NEXT_PUBLIC_ prefix). Required together with CLERK_SECRET_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Dataset API ------------------------------------------------------------

# Base URL of the Express dataset API (./api in this monorepo). Set to
# http://localhost:8000 for local dev.
FESTIVUS_DATASET_API_URL=http://localhost:8000

# Optional read-tier API key. Most endpoints are anonymously readable;
# only the keyed endpoints require this.
FESTIVUS_DATASET_API_KEY=

# Write-tier API key used by the moderator-only server actions and the
# agent on-behalf-of forwarder. Generate via:
#   pnpm --filter @festivus/api exec tsx src/scripts/mint-moderator-web-key.ts
# Paste the printed plaintext here. Without this, write paths refuse.
FESTIVUS_MODERATOR_KEY=

# HMAC secret for signing edit-confirmation tokens. Must be ≥32 chars.
# Generate with `openssl rand -hex 32`.
FESTIVUS_AGENT_CHAT_SECRET=

# --- External integrations --------------------------------------------------

# GitHub token used to fetch open contribution tasks for the
# /contribute page. Only needs `public_repo` read scope.
FESTIVUS_GITHUB_TOKEN=

# Anthropic API key, used implicitly by the SDK in the /api/agent
# route. Generate at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# --- Analytics (optional) ---------------------------------------------------
#
# These IDs are not secrets (they render into the client bundle by
# design), but they live in env vars for per-environment scoping. Each
# tag self-skips when its var is unset.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
ANALYTICS_GA4_MEASUREMENT_ID=

# TelemetryDeck app ID (UUID).
ANALYTICS_TELEMETRYDECK_APP_ID=

# TelemetryDeck signal-type namespace, e.g. `your-org.your-app`.
ANALYTICS_TELEMETRYDECK_NAMESPACE=

# --- Optional --------------------------------------------------------------

# Override for the agent trace directory (dev-only).
FESTIVUS_TRACE_DIR=
