# api: Express dataset API environment variables.
#
# Copy this file to `api/.env.local` and fill in values for local dev.
# `api/.env.local` is gitignored.

# --- Server -----------------------------------------------------------------

# Express listen port. Defaults to 8000 if unset.
PORT=8000

# Base URL the seed scripts use to call this service's own routes
# (e.g. POST /v1/simulations). Defaults to http://localhost:${PORT}.
API_SELF_URL=

# --- Auth (Clerk JWT verification) ------------------------------------------

# Clerk server-side secret. Required in production for the routes that
# verify session JWTs forwarded from apps/web. In local dev with Clerk
# unset, the middleware falls back to trusting an `X-Dev-User-Id`
# header, which is fine for solo development but not for any deployed
# environment. Generate at https://dashboard.clerk.com.
CLERK_SECRET_KEY=

# --- Database ---------------------------------------------------------------

# Postgres connection string. `supabase start` defaults to
# postgresql://postgres:postgres@localhost:54322/postgres.
POSTGRES_URL=

# --- AI / enrichment --------------------------------------------------------

# Anthropic API key. Used by enrichment scripts and the agent route.
# Generate at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# --- Email notifications (SES) ----------------------------------------------

# Master flag. Set to "true" to actually send mail; any other value is
# dry-run (logs only). Leave dry-run for local dev.
SES_ENABLED=

# AWS SES region. Defaults to us-west-2 when unset.
AWS_SES_REGION=

# AWS access key + secret for SES. Generate via the AWS IAM console for
# the IAM user that owns SES sending in your account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Moderator email allowlist. MODERATOR_EMAILS is a comma-separated
# list and supersedes the legacy MODERATOR_EMAIL. Leave both blank to
# fall back to the baked-in default list in src/notifications/email.ts.
MODERATOR_EMAIL=
MODERATOR_EMAILS=

# From-address for moderator emails (must be SES-verified).
SES_FROM_EMAIL=

# Base URL for clickable links inside outgoing emails. Defaults to
# http://localhost:3000 for local dev.
FESTIVUS_WEB_URL=

# --- Smoke test scripts -----------------------------------------------------

# Base URLs for the api and web smoke checks. Default to localhost.
API_URL=
WEB_URL=

# --- External render integration --------------------------------------------

# Server-side key for an external policy-render service. Held in api/
# only. Without it, the /v1/simulations route fails fast.
ONECLICK_API_KEY=

# --- Search engine (optional) -----------------------------------------------

# Self-hosted Typesense connection. When all three are set, /v1/search
# routes through Typesense. When any is missing, the API falls back to
# Postgres tsvector search; local dev without a Typesense host stays
# functional.
TYPESENSE_HOST=
TYPESENSE_PORT=
TYPESENSE_API_KEY=

# Optional protocol override. Defaults to "http".
TYPESENSE_PROTOCOL=

# --- Seed + maintenance scripts ---------------------------------------------

# Base URL the seed-simulations script hits. Defaults to local api.
FESTIVUS_SEED_API_BASE=

# Required safeword for wipe-simulations. Set to "yes, wipe" to confirm.
CONFIRM_WIPE=
