{
  "name": "@festivus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "pretypecheck": "prisma generate --schema=./prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "enrich": "tsx src/scripts/enrich-robots.ts",
    "reset:robots": "tsx prisma/reset-robots.ts",
    "reset:compatibility-edges": "tsx prisma/reset-compatibility-edges.ts",
    "reset:laundry-compat-edges": "tsx prisma/reset-laundry-compat-edges.ts",
    "sync:laundry-review": "tsx prisma/sync-laundry-review.ts",
    "smoke": "tsx src/scripts/smoke-local.ts",
    "seed:simulations": "tsx src/scripts/seed-simulations.ts",
    "seed:tasks": "tsx src/scripts/seed-tasks.ts",
    "wipe:simulations": "tsx src/scripts/wipe-simulations.ts",
    "typesense:backfill": "tsx src/scripts/typesense-backfill.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@aws-sdk/client-ses": "^3.1033.0",
    "@clerk/backend": "^1.13.0",
    "@festivus/scrape": "workspace:*",
    "@festivus/types": "workspace:*",
    "@prisma/client": "^6.19.3",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
