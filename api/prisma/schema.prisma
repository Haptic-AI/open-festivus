/// Individual render submission to the oneclick-policy service (spec 025 + 026).
/// One row per episode of a parent Simulation — durable, queryable, per-submission state.
/// Status transitions: pending -> running -> (done | failed).
/// Spec 026: renamed from `simulations`. `simulation_id` + `episode_index` are
/// nullable in this phase and tightened to NOT NULL in Phase 3.3 once the
/// creation flow always populates them.
model episodes {
  id              String           @id @default(cuid())
  simulation_id   String
  episode_index   Int
  hf_url          String
  env_slug        String
  policy_slug     String?
  task_slug       String?
  oneclick_job_id String?
  status          SimulationStatus @default(pending)
  video_url       String?
  error_message   String?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)

  simulation simulations @relation(fields: [simulation_id], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_episodes_status")
  @@index([created_at], map: "idx_episodes_created_at")
  @@index([env_slug], map: "idx_episodes_env_slug")
  @@index([simulation_id], map: "idx_episodes_simulation_id")
}

enum SimulationStatus {
  pending
  running
  done
  failed
}

/// Parent Simulation grouping N Episodes (spec 026).
/// Owns the policy × environment (× task? × robot?) taxonomy for a rendered run.
model simulations {
  id               String   @id @default(cuid())
  slug             String   @unique
  policy_slug      String
  environment_slug String
  task_slug        String?
  robot_slug       String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  episodes episodes[]

  @@index([policy_slug], map: "idx_simulations_policy_slug")
  @@index([environment_slug], map: "idx_simulations_environment_slug")
}

/// Audit trail for every data mutation. Edits land optimistically (live
/// immediately) and sit in pending_review until a moderator acts.
model mutations {
  id          Int       @id @default(autoincrement())
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  table_name  String
  slug        String
  field_path  String    // top-level field that changed (e.g. "weight_kg")
  actor_id    String    // Clerk user ID of the person who made the edit
  actor_email String?   // denormalized for moderator convenience
  author_id   String?   // FK to users.id (spec 029). Nullable for pre-spec rows; backfilled in Step 1.5.
  reason      String?
  patch       Json      // the partial object sent by the caller
  old_values  Json      // previous values of ONLY the changed fields
  new_values  Json      // new values of ONLY the changed fields
  status      String    @default("pending_review") // pending_review | approved | rejected | reverted
  reviewed_by String?   // Clerk user ID of the moderator
  reviewed_at DateTime? @db.Timestamptz(6)
  review_note String?   // moderator's reason for approve/reject/revert

  author users? @relation(fields: [author_id], references: [id], onDelete: SetNull)

  @@index([table_name, slug], map: "idx_mutations_table_slug")
  @@index([status], map: "idx_mutations_status")
  @@index([created_at], map: "idx_mutations_created_at")
  @@index([actor_id], map: "idx_mutations_actor_id")
  @@index([author_id, created_at(sort: Desc)], map: "idx_mutations_author_id_created_at")
}

/// Canonical user row keyed on Clerk user id (spec 029). Every API-key owner
/// and every moderation author resolves to a row here. Nullable FKs on
/// api_keys.owner_id and mutations.author_id point at this table; rows created
/// before spec 029 cutover may have those FKs null.
model users {
  id            String   @id @default(cuid())
  clerk_user_id String   @unique
  email         String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  api_keys  api_keys[]
  mutations mutations[]
}

/// Workbench project persistent state (spec 028). One row per user × project.
/// Replaces the Upstash Redis backing store. `data` JSONB holds the full
/// IPersistedWorkbenchState; validated by Zod on every read in apps/web.
model workbench_projects {
  id         Int      @id @default(autoincrement())
  project_id String
  user_id    String
  name       String
  data       Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@unique([project_id, user_id])
  @@index([user_id, updated_at(sort: Desc)], map: "idx_workbench_projects_user_updated")
}
