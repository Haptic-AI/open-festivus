model api_keys {
  id           Int       @id @default(autoincrement())
  user_id      String
  key_hash     String    @unique
  name         String?
  tier         String    @default("free")
  owner_email  String?   // Snapshot of the Clerk user's primary email at mint time. Used as the reply-to on submitter notifications.
  owner_id     String?   // FK to users.id (spec 029). Nullable for pre-spec rows; backfilled in Step 1.5.
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)

  owner users? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "idx_api_keys_user_id")
  @@index([owner_id], map: "idx_api_keys_owner_id")
}

