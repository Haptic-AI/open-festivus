# dependencies
node_modules/

# next.js
.next/
.next-build/
out/

# build
dist/

# env
.env
.env.local
.env.*.local

# debug
npm-debug.log*
pnpm-debug.log*

# vercel
.vercel

# misc
.DS_Store
*.tsbuildinfo
.env*.local
.mcp.json

# python caches
scripts/__pycache__/

# scrape cache (regenerate on demand, never commit)
.cache/

# trace artifacts
.festivus-traces/

# OSS release staging (spec 030). Curated subset is normally written to
# ../open-festivus-staging/ (parent dir) — this entry is defensive in case
# someone runs the release script with --out pointing inside the repo.
open-festivus-staging/
../open-festivus-staging/

# generated by apps/web/scripts/build-prompts.mjs (regenerated on dev/build/test)
apps/web/src/lib/agent/prompts.generated.ts

# playwright mcp artifacts
.playwright-mcp/
workbench-*.png

# loose screenshots dropped at the repo root — keep git status clean
# and stop `git add -A` from hoovering them into commits. Tracked
# images in subdirs (apps/web/public/, docs/, docs/pr-images/) unaffected.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# AWS / Vercel preview secrets pulled per-environment — never commit
api/.env.vercel.preview
api/.env.vercel.production
# IntelliJ
.idea/
api/.idea/
# Script state (enrichment checkpoint, not seed)
api/src/scripts/.enrichment-state.json

# supabase local dev (belt-and-suspenders; supabase/.gitignore also excludes)
supabase/.temp/

# supabase self-host provision state (contains EC2 IDs, not secrets, but per-run)
infra/supabase-ec2/.state.env

# infra state files (instance IDs, EIPs — non-secret but env-specific)
infra/*/.state.env
infra/festivus-typesense/typesense-app/.git/
