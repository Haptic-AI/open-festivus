# packages/scrape — environment variables.
#
# Copy this file to `packages/scrape/.env.local` and fill in values. Gitignored.

# ScrapingBee API key — used by packages/scrape/src/env.ts to hit the
# ScrapingBee proxy service. Required for scraper scripts that call
# external sites via the proxy.
SCRAPINGBEE_API_KEY=
